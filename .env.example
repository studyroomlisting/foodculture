# ============================================================
# FoodCulture AI — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed for server-side writes (admin/moderation). Optional.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CITY=Bengaluru

# Transactional email — Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=FoodCulture AI <hello@foodculture.ai>

# Optional — notify influencer on connection request
INFLUENCER_NOTIFY_EMAIL=
